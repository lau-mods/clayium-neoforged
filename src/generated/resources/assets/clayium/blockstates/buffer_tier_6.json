{
  "multipart": [
    {
      "apply": {
        "model": "clayium:block/buffer_tier_6"
      }
    },
    {
      "apply": {
        "model": "clayium:block/buffer_face_down_input"
      },
      "when": {
        "down": "input"
      }
    },
    {
      "apply": {
        "model": "clayium:block/buffer_face_down_output"
      },
      "when": {
        "down": "output"
      }
    },
    {
      "apply": {
        "model": "clayium:block/buffer_face_up_input"
      },
      "when": {
        "up": "input"
      }
    },
    {
      "apply": {
        "model": "clayium:block/buffer_face_up_output"
      },
      "when": {
        "up": "output"
      }
    },
    {
      "apply": {
        "model": "clayium:block/buffer_face_north_input"
      },
      "when": {
        "north": "input"
      }
    },
    {
      "apply": {
        "model": "clayium:block/buffer_face_north_output"
      },
      "when": {
        "north": "output"
      }
    },
    {
      "apply": {
        "model": "clayium:block/buffer_face_south_input"
      },
      "when": {
        "south": "input"
      }
    },
    {
      "apply": {
        "model": "clayium:block/buffer_face_south_output"
      },
      "when": {
        "south": "output"
      }
    },
    {
      "apply": {
        "model": "clayium:block/buffer_face_west_input"
      },
      "when": {
        "west": "input"
      }
    },
    {
      "apply": {
        "model": "clayium:block/buffer_face_west_output"
      },
      "when": {
        "west": "output"
      }
    },
    {
      "apply": {
        "model": "clayium:block/buffer_face_east_input"
      },
      "when": {
        "east": "input"
      }
    },
    {
      "apply": {
        "model": "clayium:block/buffer_face_east_output"
      },
      "when": {
        "east": "output"
      }
    },
    {
      "apply": {
        "model": "clayium:block/buffer_filter_face"
      },
      "when": {
        "facing": "north",
        "filtered": "true"
      }
    },
    {
      "apply": {
        "model": "clayium:block/buffer_filter_face",
        "y": 90
      },
      "when": {
        "facing": "east",
        "filtered": "true"
      }
    },
    {
      "apply": {
        "model": "clayium:block/buffer_filter_face",
        "y": 180
      },
      "when": {
        "facing": "south",
        "filtered": "true"
      }
    },
    {
      "apply": {
        "model": "clayium:block/buffer_filter_face",
        "y": 270
      },
      "when": {
        "facing": "west",
        "filtered": "true"
      }
    }
  ]
}