{
  "reference": {
    "mod": "Clayium 0.4.6.36 hotfix2 for Minecraft 1.7.10",
    "method": "The original Gui classes were inspected from bytecode. GuiTemp supplies a four-pixel nine-tile border, machine-area height plus a 94-pixel player inventory, title at 6,6, and dark-gray text 0x404040.",
    "fontDifference": "Minecraft 1.21.1 font metrics, GUI scaling, narration, and accessibility focus rendering are allowed differences.",
    "buttonMapping": "button.png is a 16x16 icon atlas, not a 200x20 widget strip. Text controls use Minecraft's widget/button, widget/button_highlighted and widget/button_disabled sprites; no icon atlas cells are resampled into text controls.",
    "verificationLimit": "The SHA-256-pinned hotfix2 JAR was decompiled for the original layouts. Conditional layouts retain their exact formulas from their original Container classes.",
    "originalJarSha256": "c16e35d241d46c290e07f5d0cfd35e498db79be33a374615782163ef0f5801f2",
    "originalCoordinateEvidence": {
      "GuiTemp": "ContainerTemp initializes machineGuiSizeX=176 and machineGuiSizeY=72; GuiTemp sets imageWidth=machineGuiSizeX and imageHeight=machineGuiSizeY+94. GuiTemp draws the title at (6,6), color 0x404040. Player slots use offsetX+8+18*column, offsetY+12+18*row; hotbar uses offsetY+70.",
      "GuiClayMachines": "ContainerClayMachines sets the input slot to (44,35) and result slot to (116,35).",
      "GuiWaterWheel": "GuiWaterWheel renders progress text at (6,machineGuiSizeY-12), durability at (90,machineGuiSizeY-12), and surrounding-water text at (90,machineGuiSizeY), all color 0x404040.",
      "GuiPANCore": "Constructor initializes tableX=11, tableY=18, sliderWidth=10, marginR=11, and marginB=14; comparator choices are item, cost, and consumption.",
      "GuiAutoTrader": "ContainerAutoTrader uses a 176x182 window with input slots (36,53), (62,53), result (120,53), and player inventory (8,100). GuiAutoTrader renders offer buy A/B/sell at (36,24), (62,24), (120,24), with 16x16 tooltips; previous/next buttons are 12x19 at (17,23)/(147,23); disabled overlays are 28x21 at (83,21)/(83,51)."
    },
    "assetVerification": "All 19 GUI asset digests were recomputed from assets/clayium/textures/gui/ in the SHA-256-pinned original JAR and match this table.",
    "comparisonMethod": "Each screens[] row pairs originalLayout with portedLayout. Coordinates are relative to the upper-left GUI origin; screenshots are captured by tests/e2e/gui-parity.mjs. Generic source classes use their concrete menu example in portedScreens."
  },
