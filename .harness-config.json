{
  "parallel": 3,
  "gradle": {
    "compile": "classes",
    "build": "build",
    "gameTest": "runGameTestServer"
  },
  "agents": {
    "plan": {
      "type": "claude",
      "command": "claude",
      "model": "claude-opus-5-5",
