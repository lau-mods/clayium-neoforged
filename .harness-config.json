      "retry": {
        "model": "claude-sonnet-5-5",
        "effort": "medium"
      }
    },
    "e2eReview": {
      "type": "claude",
      "command": "claude",
      "initial": {
        "model": "claude-opus-5-5",
        "effort": "high"
      },
      "retry": {
        "model": "claude-sonnet-5-5",
        "effort": "high"
      }
    }
  },
  "recipeViewerProfiles": {
    "emi": {
      "directory": "profiles/emi",
